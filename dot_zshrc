#
# ~/.zshrc
#

# --- History ---------------------------------------------------------------
HISTFILE=~/.zsh_history
HISTSIZE=50000
SAVEHIST=50000
setopt SHARE_HISTORY          # share history between open terminals
setopt HIST_IGNORE_ALL_DUPS   # no duplicate entries
setopt HIST_IGNORE_SPACE      # commands starting with a space aren't saved
setopt HIST_REDUCE_BLANKS
setopt EXTENDED_HISTORY       # save timestamps

# --- General ---------------------------------------------------------------
setopt AUTO_CD                # type a folder name to cd into it
setopt INTERACTIVE_COMMENTS   # allow # comments in pasted commands
setopt NO_BEEP
bindkey -e                    # emacs-style keys (Ctrl+A, Ctrl+E, ...)

# Ctrl+Left/Right jump words, Home/End/Delete work as expected
bindkey '^[[1;5D' backward-word
bindkey '^[[1;5C' forward-word
bindkey '^[[H' beginning-of-line
bindkey '^[[F' end-of-line
bindkey '^[[3~' delete-char

# --- Completion ------------------------------------------------------------
autoload -Uz compinit
compinit -d ~/.cache/zcompdump
zstyle ':completion:*' menu select                         # arrow-key menu
zstyle ':completion:*' matcher-list 'm:{a-z}={A-Za-z}'     # case-insensitive
zstyle ':completion:*' list-colors "${(s.:.)LS_COLORS}"
zstyle ':completion:*' use-cache on
zstyle ':completion:*' cache-path ~/.cache/zsh

# --- Aliases ---------------------------------------------------------------
alias ls='ls --color=auto'
alias ll='ls -lah --color=auto'
alias grep='grep --color=auto'

if (( $+commands[eza] )); then
  alias ls='eza --group-directories-first'
  alias ll='eza -lah --git --group-directories-first'
  alias lt='eza --tree --level=2 --git-ignore'
fi
(( $+commands[bat] )) && export MANPAGER="sh -c 'col -bx | bat -l man -p'" MANROFFOPT='-c'
(( $+commands[lazygit] )) && alias lg='lazygit'

# AI coding CLIs
alias c='claude'
alias o='codex'
alias oc='opencode --auto'   # opencode's equivalent of --dangerously-skip-permissions

# Update Claude Code and Codex; the second runs even if the first fails
au() {
  print -P '%F{cyan}==> Updating Claude Code%f'
  claude update
  print -P '%F{cyan}==> Updating Codex%f'
  curl -fsSL https://chatgpt.com/codex/install.sh | sh
}

# --- Tools -----------------------------------------------------------------
source <(fzf --zsh)               # Ctrl+R history, Ctrl+T files, Alt+C cd
eval "$(zoxide init zsh)"         # z <dir>, zi for interactive pick
eval "$(starship init zsh)"       # prompt
(( $+commands[direnv] )) && eval "$(direnv hook zsh)"   # auto-load .envrc
(( $+commands[mise] )) && eval "$(mise activate zsh)"   # per-project tool versions
(( $+commands[uv] )) && eval "$(uv generate-shell-completion zsh)"

# fzf: use fd (respects .gitignore) and bat previews when available
if (( $+commands[fd] )); then
  export FZF_DEFAULT_COMMAND='fd --type f --hidden --exclude .git'
  export FZF_CTRL_T_COMMAND="$FZF_DEFAULT_COMMAND"
  export FZF_ALT_C_COMMAND='fd --type d --hidden --exclude .git'
fi
(( $+commands[bat] )) && export FZF_CTRL_T_OPTS="--preview 'bat --color=always --line-range :200 {}'"

# --- Plugins (syntax highlighting must be last) ----------------------------
source /usr/share/zsh/plugins/zsh-autosuggestions/zsh-autosuggestions.zsh
source /usr/share/zsh/plugins/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh

# --- fastfetch on each new Ghostty window, tab or split --------------------
if [[ $(< /proc/$PPID/comm) == ghostty ]] && (( $+commands[fastfetch] )); then
  ~/.config/fastfetch/auto.sh   # logo size follows window width
fi

# --- GitHub MCP (Claude Code plugin) reuses the gh CLI token ---------------
export GITHUB_PERSONAL_ACCESS_TOKEN="$(gh auth token 2>/dev/null)"

# bun completions
[ -s "/home/linuxdev/.bun/_bun" ] && source "/home/linuxdev/.bun/_bun"
